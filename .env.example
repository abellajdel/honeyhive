# Mono-repo `.env`: copy to `.env` and fill keys (do not commit `.env`).
OPENAI_API_KEY=
HONEYHIVE_API_KEY=

# HoneyHive project name (same variable for fraud-agent and kyc_onboarding). Swap value when switching demos:
#   fraud-triage-demo  — fraud LangGraph demo
#   kyc-onboarding      — KYC LangGraph demo
HONEYHIVE_PROJECT=fraud-triage-demo

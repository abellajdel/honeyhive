OPENAI_API_KEY=your_openai_key_here
# Seconds per OpenAI HTTP request via LangChain (default 180 in code; prevents indefinite hangs).
# OPENAI_REQUEST_TIMEOUT=180
# OPENAI_MAX_RETRIES=2
HONEYHIVE_API_KEY=your_honeyhive_key_here
HONEYHIVE_PROJECT=fraud-triage-demo

# Optional: set to true only if your HoneyHive API + SDK agree on session API responses.
# Default (unset) skips REST session creation and uses client UUIDs in OTEL baggage (recommended
# when the SDK errors on PostSessionStartResponse / org_id / workspace_id).
# HONEYHIVE_USE_BACKEND_SESSION=false

# OTLP export read timeout (seconds). SDK default is 30s; increase on slow networks / VPNs.
# HH_OTLP_HTTP_TIMEOUT=120

# Batch OTLP spans (recommended; fewer gateway round-trips). Set 0/false/no for immediate per-span export.
# HONEYHIVE_OTLP_BATCH=1

# Retries when OTLP returns 502/504 etc. (default 5 attempts, 2s initial backoff).
# HH_OTLP_EXPORT_ATTEMPTS=5
# HH_OTLP_EXPORT_INITIAL_DELAY=2.0

# Max time for final span flush (ms) when batching.
# HONEYHIVE_FLUSH_TIMEOUT_MS=120000

# Skip OTLP flush (drops pending spans; troubleshooting only).
# HONEYHIVE_SKIP_FLUSH=false
